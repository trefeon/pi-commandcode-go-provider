{
  "name": "pi-commandcode-go-provider",
  "version": "0.3.2",
  "description": "Command Code Go ($1/mo plan) custom provider extension for Oh My Pi (OMP) and Pi coding agent",
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "scripts": {
    "test": "bun test tests/",
    "typecheck": "tsc --noEmit",
    "catalog:generate": "bun run scripts/generate-catalog.ts",
    "catalog:check": "bun run scripts/generate-catalog.ts --check"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "keywords": [
    "pi-extension",
    "omp",
    "commandcode",
    "commandcode-go",
    "provider"
  ],
  "author": "trefeon",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
